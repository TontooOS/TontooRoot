name: dock
execute: /usr/local/bin/start-dock.sh
type: sys
user: liveuser
depends_on:
  - compositor
  - live-setup
restart: true
no_new_privs: true
private_tmp: true
protect_system: full
read_only_paths:
  - /usr
  - /System
  - /Library/System
memory_max: 512M
tasks_max: 1024
env_allow:
  - XDG_RUNTIME_DIR
  - WAYLAND_DISPLAY
