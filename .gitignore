# Build outputs (never commit)
out/
work/
vm/
*.iso

# Staged ISO artifacts inside airootfs.
# These are regenerated by scripts/build-iso.sh via scripts/stage-*.sh
# from the in-repo sources (BaseOS/fonts, BaseOS/wallpapers) and from
# external component repos (compositor, FishRunner, FishPerms, Launchpad,
# TontooProgramms/Menubar, TontooProgramms/Dock, TontooLibs). Do not commit them.
archiso/airootfs/usr/share/fonts/OTF/
archiso/airootfs/usr/share/fonts/TTF/
archiso/airootfs/System/User/Wallpapers/
archiso/airootfs/usr/share/tontoo/wallpapers
archiso/airootfs/usr/share/icons/MacTahoe-cursors/
archiso/airootfs/usr/share/icons/MacTahoe-dark-cursors/
archiso/airootfs/usr/share/themes/MacTahoe-*/
archiso/airootfs/usr/bin/tontoo-compositor
archiso/airootfs/usr/bin/tontoo-shell-ui
archiso/airootfs/usr/bin/tapp
archiso/airootfs/usr/bin/fishperms-daemon
archiso/airootfs/usr/bin/fishpermctl
archiso/airootfs/usr/bin/fishperms-prompt
archiso/airootfs/usr/bin/fishbox
archiso/airootfs/usr/bin/launchpad-daemon
archiso/airootfs/usr/bin/launchctl
archiso/airootfs/Library/System/*.library
archiso/airootfs/Libraries/TontooUI/
archiso/airootfs/System/Applications/Menubar.app/
archiso/airootfs/System/Applications/Dock.app/
archiso/airootfs/System/Applications/systemoverview.app/
archiso/airootfs/System/Applications/AboutThisApp.app/
archiso/airootfs/Applications/SystemOverview.app
archiso/airootfs/usr/local/lib/node_modules/
archiso/airootfs/usr/share/tapp/lang/
archiso/airootfs/usr/share/launchpad/lang/
archiso/airootfs/usr/share/tontoo/menubar/lang/
archiso/airootfs/usr/share/tontoo/dock/lang/
archiso/airootfs/Applications/Terminal.app/
archiso/airootfs/Applications/Weather.app/
archiso/airootfs/usr/share/terminal/lang/
archiso/airootfs/usr/share/terminal/tontoo-prompt.zsh
archiso/airootfs/usr/share/weather/lang/

# Generated SSH host keys (stage-sshd.sh recreates them). Never commit keys.
archiso/airootfs/etc/ssh/ssh_host_*

# Logs
*.log

# OS / editor junk
.DS_Store
Thumbs.db
*~
*.swp
